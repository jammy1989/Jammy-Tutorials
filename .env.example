# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET: server only. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Students log in with an ID (e.g. "jt001"). Internally it becomes jt001@<this domain>.
# Choose once and never change it after creating students.
NEXT_PUBLIC_ID_DOMAIN=students.example.com

NEXT_PUBLIC_SITE_NAME=Jamshed Tutorials
